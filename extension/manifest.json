{
  "manifest_version": 3,
  "name": "Grove – Focus Timer",
  "version": "0.2.0",
  "description": "Grow a plant while you focus. Distracting sites are blocked until it's fully grown.",
  "action": { "default_popup": "popup.html", "default_icon": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" } },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "background": { "service_worker": "background.js", "scripts": ["background.js"], "type": "module" },
  "options_ui": { "page": "app.html", "open_in_tab": true },
  "permissions": ["storage", "alarms", "declarativeNetRequest", "notifications", "offscreen"],
  "optional_host_permissions": ["*://*/*"],
  "web_accessible_resources": [{ "resources": ["blocked.html", "blocked.js", "store.js", "shared/*"], "matches": ["<all_urls>"] }],
  "browser_specific_settings": { "gecko": { "id": "grove-focus@grove.app", "strict_min_version": "128.0" } }
}
